{
  "name": "cgrid-ext-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:customizer": "playwright test e2e/customizer.spec.ts e2e/spine.spec.ts e2e/customizer-*.spec.ts --project=chromium",
    "test:e2e:parity": "playwright test e2e/customizer.spec.ts e2e/customizer-*.spec.ts e2e/savedFilters.spec.ts e2e/formattingToolbar.spec.ts e2e/formatPicker.spec.ts e2e/iconRibbon.spec.ts e2e/columnConfig.spec.ts e2e/layoutsToolbar.spec.ts --project=chromium",
    "smoke:customizer": "node scripts/customizer-smoke.mjs"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.1.1",
    "@wellsfargo-starui/velocity-grid-ext": "*",
    "@wellsfargo-starui/velocity-grid": "*",
    "@wellsfargo-starui/velocity-grid-format": "*",
    "@wellsfargo-starui/velocity-grid-edit": "*",
    "@wellsfargo-starui/velocity-grid-calc": "*",
    "@wellsfargo-starui/velocity-grid-rules": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}
