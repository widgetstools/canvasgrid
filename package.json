{
  "name": "canvasgrid-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:showcase": "npm run dev --workspace=cgrid-showcase",
    "dev:positions": "npm run dev --workspace=cgrid-positions",
    "build": "turbo run build",
    "build:kernel": "npm run build --workspace=@cgrid/kernel",
    "test": "turbo run test",
    "test:kernel": "npm test --workspace=@cgrid/kernel",
    "typecheck": "turbo run typecheck",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\" \"apps/cgrid-positions/src/**/*.ts\" \"apps/cgrid-positions/e2e/**/*.ts\" \"apps/cgrid-showcase/src/**/*.ts\" \"apps/cgrid-showcase/e2e/**/*.ts\""
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "turbo": "^2.10.2",
    "typescript-eslint": "^8.62.1"
  }
}
