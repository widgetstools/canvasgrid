{
  "name": "canvasgrid-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:showcase": "npm run dev --workspace=cgrid-showcase",
    "dev:positions": "npm run dev --workspace=cgrid-positions",
    "dev:customizer": "npm run dev --workspace=cgrid-customizer-demo",
    "dev:colgroups": "npm run dev --workspace=colgroups",
    "dev:ag-showcase": "npm run dev --workspace=showcase",
    "dev:ext-demo": "npm run dev --workspace=cgrid-ext-demo",
    "dev:ssrm-demo": "npm run dev --workspace=cgrid-ssrm-demo",
    "dev:ext-ssrm-demo": "npm run dev --workspace=cgrid-ext-ssrm-demo",
    "dev:stomp": "node scripts/run-stomp.mjs",
    "ext-demo:openfin": "node scripts/run-ext-openfin.mjs",
    "verify:demos": "node scripts/verify-demos.mjs",
    "build": "turbo run build",
    "build:kernel": "npm run build --workspace=@cgrid/kernel",
    "test": "turbo run test",
    "test:kernel": "npm test --workspace=@cgrid/kernel",
    "typecheck": "turbo run typecheck",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\" \"apps/*/src/**/*.{ts,tsx}\" \"apps/*/e2e/**/*.ts\""
  },
  "devDependencies": {
    "@openfin/node-adapter": "^43.101.2",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "turbo": "^2.10.5",
    "typescript-eslint": "^8.62.1",
    "wait-on": "^9.0.10"
  }
}
