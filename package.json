{
  "name": "velocitygrid-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:showcase": "npm run dev --workspace=velocitygrid-showcase",
    "dev:positions": "npm run dev --workspace=velocitygrid-positions",
    "dev:customizer": "npm run dev --workspace=velocitygrid-customizer-demo",
    "dev:colgroups": "npm run dev --workspace=colgroups",
    "dev:ag-showcase": "npm run dev --workspace=showcase",
    "dev:ext-demo": "npm run dev --workspace=velocitygrid-ext-demo",
    "dev:ssrm-demo": "npm run dev --workspace=velocitygrid-ssrm-demo",
    "dev:perspective-ssrm-sample": "npm run dev --workspace=velocitygrid-perspective-ssrm-sample",
    "dev:vg-lab": "npm run dev --workspace=velocitygrid-vg-lab",
    "dev:ext-react": "npm run dev --prefix examples/cgrid-ext-react",
    "dev:ext-angular": "npm run dev --prefix examples/cgrid-ext-angular",
    "dev:ext-angular-ssrm": "npm run dev --prefix examples/cgrid-ext-angular-ssrm",
    "examples:install": "node scripts/install-example-apps.mjs",
    "dev:stomp": "node scripts/run-stomp.mjs",
    "dev:stomp-perspective": "concurrently -k -n broker,sample -c blue,green \"npm run dev:stomp\" \"wait-on tcp:8082 && npm run dev:perspective-ssrm-sample\"",
    "ext-demo:openfin": "node scripts/run-ext-openfin.mjs",
    "verify:demos": "node scripts/verify-demos.mjs",
    "build": "turbo run build",
    "build:kernel": "npm run build --workspace=@wellsfargo-starui/velocity-grid",
    "build:tarballs": "node scripts/build-tarballs.mjs",
    "test": "turbo run test",
    "test:kernel": "npm test --workspace=@wellsfargo-starui/velocity-grid",
    "typecheck": "turbo run typecheck",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\" \"apps/*/src/**/*.{ts,tsx}\" \"apps/*/e2e/**/*.ts\""
  },
  "devDependencies": {
    "@openfin/node-adapter": "^43.101.2",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "turbo": "^2.10.5",
    "typescript-eslint": "^8.62.1",
    "wait-on": "^9.0.10"
  }
}
