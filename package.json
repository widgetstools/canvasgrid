{
  "name": "velocitygrid-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:csrm-provider": "npm run dev --workspace=velocitygrid-csrm-provider-demo",
    "dev:ssrm-provider": "npm run dev --workspace=velocitygrid-ssrm-provider-demo",
    "dev:ext-react": "npm run dev --prefix examples/cgrid-ext-react",
    "dev:ext-angular": "npm run dev --prefix examples/cgrid-ext-angular",
    "dev:ext-angular-ssrm": "npm run dev --prefix examples/cgrid-ext-angular-ssrm",
    "examples:install": "node scripts/install-example-apps.mjs",
    "dev:stomp": "node scripts/run-stomp.mjs",
    "audit:ext-chrome": "node scripts/audit-ext-chrome.mjs",
    "audit:ext-classes": "node scripts/audit-ext-classes.mjs",
    "verify:demos": "node scripts/verify-demos.mjs",
    "build": "turbo run build",
    "build:kernel": "npm run build --workspace=@wellsfargo-starui/velocity-grid",
    "build:tarballs": "node scripts/build-tarballs.mjs",
    "tarballs:install-into": "node scripts/install-tarballs-into.mjs",
    "test": "turbo run test",
    "test:kernel": "npm test --workspace=@wellsfargo-starui/velocity-grid",
    "typecheck": "turbo run typecheck",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"packages/*/tests/**/*.ts\" \"apps/*/src/**/*.{ts,tsx}\" \"apps/*/e2e/**/*.ts\"",
    "dev:stomp-ssrm-provider": "concurrently -k -n broker,app -c blue,green \"npm run dev:stomp\" \"wait-on tcp:8082 && npm run dev:ssrm-provider\"",
    "dev:stomp-csrm-provider": "concurrently -k -n broker,app -c blue,green \"npm run dev:stomp\" \"wait-on tcp:8082 && npm run dev:csrm-provider\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@openfin/node-adapter": "^43.101.2",
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "turbo": "^2.10.11",
    "typescript-eslint": "^8.62.1",
    "wait-on": "^9.0.10"
  }
}
