{
  "name": "@wellsfargo-starui/velocity-grid-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./editor": {
      "types": "./src/editor/index.ts",
      "import": "./src/editor/index.ts"
    },
    "./worker": {
      "types": "./src/worker.ts",
      "import": "./src/worker.ts"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "import": "./src/storage/index.ts"
    },
    "./appdata": {
      "types": "./src/appdata/index.ts",
      "import": "./src/appdata/index.ts"
    }
  },
  "scripts": {
    "build": "echo '@wellsfargo-starui/velocity-grid-data ships source (worker URLs resolve in the consuming app bundle)' && exit 0",
    "build:hub-worker": "vite build -c vite.hubWorker.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0"
  },
  "peerDependencies": {
    "@wellsfargo-starui/velocity-grid": "*"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^2.1.0",
    "happy-dom": "^20.0.10",
    "@wellsfargo-starui/velocity-grid": "*",
    "@codemirror/view": "^6.43.6"
  }
}
