{
  "name": "@wellsfargo-starui/velocity-grid",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/velocity-grid.js",
  "types": "./dist/velocityGrid.d.ts",
  "exports": {
    ".": {
      "types": "./dist/velocityGrid.d.ts",
      "import": "./dist/velocity-grid.js"
    },
    "./style.css": "./dist/velocity-grid.css",
    "./icons/lucide.generated": {
      "types": "./src/icons/lucide.generated.ts",
      "import": "./src/icons/lucide.generated.ts"
    },
    "./ui/primitives": {
      "types": "./src/ui/primitives.ts",
      "import": "./src/ui/primitives.ts"
    },
    "./ui/primitives-enhanced": {
      "types": "./src/ui/primitives-enhanced.ts",
      "import": "./src/ui/primitives-enhanced.ts"
    },
    "./calc": {
      "types": "./src/calc/index.ts",
      "import": "./src/calc/index.ts"
    },
    "./expression": {
      "types": "./src/expression/index.ts",
      "import": "./src/expression/index.ts"
    },
    "./expression/editor": {
      "types": "./src/expression/editor.ts",
      "import": "./src/expression/editor.ts"
    },
    "./format": {
      "types": "./src/format/index.ts",
      "import": "./src/format/index.ts"
    },
    "./rules": {
      "types": "./src/rules/index.ts",
      "import": "./src/rules/index.ts"
    }
  },
  "scripts": {
    "build": "vite build && vite build -c vite.worker.config.ts && tsc --emitDeclarationOnly",
    "build:watch": "vite build --watch",
    "prebuild-icons": "tsx src/icons/build-lucide.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "bench": "vitest bench --run bench/",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "happy-dom": "^15.0.0",
    "lucide-static": "^0.469.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vitest": "^2.1.0"
  }
}
