{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "..",
    "noEmit": true,
    // Kernel src (mapped below) imports `./theming/tokens.css?inline` —
    // vite/client supplies the `*?inline` ambient module, same as kernel's
    // own tsconfig.
    "types": ["vite/client"],
    "paths": {
      "@kernel-src/*": ["../kernel/src/*"],
      // Type-only unification: tests import kernel types via relative src
      // paths while src imports `@wellsfargo-starui/velocity-grid` (dist d.ts). Since CgTheme
      // gained a private member, the src and dist declarations of the same
      // class are nominally incompatible — map the bare specifier to src so
      // ONE declaration set flows through the whole compilation. Runtime
      // resolution (vitest/node) is untouched: it still hits dist via the
      // workspace symlink.
      "@wellsfargo-starui/velocity-grid": ["../kernel/src/velocityGrid.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["dist", "node_modules"]
}
